<!DOCTYPE html>
<html lang="en">
<head>
    <%# Common metadata and Bootstrap CSS are loaded from this partial. %>
    <%- include('./partials/head') %>
    <title>My Blogs</title>
</head>
<body>
    <%# Navbar uses locals.user to show logged-in or guest links. %>
    <%- include('./partials/navbar') %>    
    
    <main class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="h3 mb-1">My Blogs</h1>
                <p class="text-muted mb-0">Manage the posts you have created.</p>
            </div>

            <a href="/blog/addblog" class="btn btn-outline-primary"><i class="bi bi-plus-lg"> Add Blog</i></a>
        </div>

        <% if(blogs.length === 0){ %>
            <div class="text-center py-5">
                <h2 class="h5">No blogs found</h2>
                <p class="text-muted">You have not created any blogs yet.</p>

                <a href="/blog/addblog" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Create Blog</a>
            </div>
        <% } else { %>
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                <% blogs.forEach(blog => { %>
                <div class="col">
                    <div class="card h-100 position-relative" >
                        <img
                            src="/blog/image/<%= blog._id %>"
                            class="card-img-top"
                            style="height: 180px; object-fit: cover;"
                            alt="<%= blog.title %>"
                            onerror="this.onerror=null; this.src='/img/default-cover.png';"
                        >

                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title"><%= blog.title %></h5>

                            <p class="card-text text-muted">
                                <%= blog.body.length > 100 ? blog.body.substring(0, 100) + '...' : blog.body %>
                            </p>

                            <div class="mt-auto d-flex gap-2">
                                <a href="/blog/<%= blog._id %>" class="btn btn-primary">Read More</a>

                                <form
                                    action="/blog/<%= blog._id %>/delete"
                                    method="POST"
                                    onsubmit="return confirm('Are you sure you want to delete this?')"
                                >
                                    <button type="submit" class="btn btn-outline-danger">Delete</button>
                                </form>

                                <div class="position-absolute bottom-0 end-0 p-2">
                                   <a href="/blog/edit/<%= blog._id %>" class="btn btn-outline-secondary"><i class="bi bi-pencil"></i></a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <% }) %>
            </div>

        <% }%>
       
        
    </main>

    
    <%# Bootstrap JavaScript is loaded after the content. %>
    <%- include('./partials/scripts') %>
</body>
</html>
