<%# Shared navbar partial used by all pages. %>
<nav class="navbar navbar-expand-lg bg-dark" data-bs-theme="dark">
  <div class="container-fluid">
    <a class="navbar-brand" href="#">BlogiFy</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavDropdown" aria-controls="navbarNavDropdown" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNavDropdown">
      <ul class="navbar-nav w-100">
        <li class="nav-item">
          <a class="nav-link" aria-current="page" href="/">Home</a>
        </li>
        <%# Show blog actions only when auth middleware provides a user. %>
        <% if (locals.user) { %>
          <li class="nav-item">
            <a class="nav-link" href="/blog/addblog">Add Blog</a>
          </li>

          <li class="nav-item">
            <a class="nav-link" href="/blog/myblogs">My Blogs</a>
          </li>

          <div class="nav-item dropdown ms-auto">
              <li class="nav-item dropdown ms-auto">
                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                  <% const authorImg = locals.user.profileImgUrl && !locals.user.profileImgUrl.includes(':\\') ? locals.user.profileImgUrl : '/img/profileimg.png'; %>
                  <img src="<%= authorImg %>" width="25" height="25"  style="border-radius: 50%; border: 1px solid #ccc; margin-bottom: 3px;" alt="<%= locals.user.fullName %>"> 
                  <!-- <i class="bi bi-person-circle"></i> -->
                </a>
                <ul class="dropdown-menu dropdown-menu-end">
                  <li><a class="dropdown-item" href="/user/<%= locals.user._id %>">My Profile</a></li>
                  <li><a class="dropdown-item" href="/user/logout">Log Out</a></li>
                </ul>
            </li>
          </div>
          

        <% } else { %>
          <li class="nav-item">
            <a class="nav-link" href="/user/signin">Sign In</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/user/signup">Sign Up</a>
          </li>
        <% } %>
        
      </ul>
    </div>
  </div>
</nav>

<%# Signin errors are rendered here when a page passes locals.error. %>
<% if (locals.error) { %>
  <div class="container mt-4">
    <div class="alert alert-danger" role="alert">
        <%= locals.error %>
    </div>
  </div>
 <% } %>

