<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('./partials/head') %>
  <title>Edit Blog</title>
</head>
<body>
  <%- include('./partials/navbar') %>

  <div class="container mt-4">
    <a href="/blog/<%= blog._id %>" class="btn btn-outline-secondary mb-3"><i class="bi bi-arrow-left"></i> Back to Blog</a>
    <h2>Edit Blog</h2>

    <form action="/blog/edit/<%= blog._id %>" method="POST" enctype="multipart/form-data"
        onsubmit="return confirm('Are you sure you want to update this blog?')">
      <div class="mb-3">
        <label for="title" class="form-label">Title</label>
        <input
          type="text"
          class="form-control"
          id="title"
          name="title"
          value="<%= blog.title %>"
          required
        >
      </div>

      <div class="mb-3">
        <label for="body" class="form-label">Body</label>
        <textarea
          class="form-control"
          id="body"
          name="body"
          rows="8"
          required
        ><%= blog.body %></textarea>
      </div>

      <div class="mb-3">
        <label class="form-label">Current Image</label><br>
        <img
          src="<%= blog.coverImgUrl %>"
          alt="Current blog image"
          class="img-fluid mb-2"
          style="max-width: 300px;"
        >
      </div>

      <div class="mb-3">
        <label for="coverImage" class="form-label">Change Image</label>
        <input
          type="file"
          class="form-control"
          id="coverImage"
          name="coverImage"
        >
      </div>

      <button type="submit" class="btn btn-primary mb-3">Update Blog</button>
    </form>
  </div>
</body>
</html>
