<!DOCTYPE html>
<html lang="en">

<head>
    <%# Common metadata and Bootstrap CSS are loaded from this partial. %>
        <%- include('./partials/head') %>
            <title>Home Page</title>
</head>

<body>
    <%# Navbar uses locals.user to show logged-in or guest links. %>
        <%- include('./partials/navbar') %>
            <main class="container py-4">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h1 class="h3 mb-1">Latest Blogs</h1>
                        <p class="text-muted mb-0">Read posts from the community.</p>
                    </div>

                    <% if (locals.user) { %>
                        <a href="/blog/addblog" class="btn btn-primary">Add Blog</a>
                    <% } %>
                </div>

                <%# The home route passes blogs so each saved post can be shown here. %>
                <% if (blogs.length === 0) { %>
                    <div class="text-center py-5">
                        <h2 class="h5">No blogs yet</h2>
                        <p class="text-muted">Be the first one to create a blog.</p>

                        <% if (locals.user) { %>
                            <a href="/blog/addblog" class="btn btn-primary">Create Blog</a>
                        <% } %>
                    </div>
                <% } else { %>
                    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                        <% blogs.forEach(blog=> { %>
                            <div class="col">
                                <div class="card h-100">
                                    <img
                                        src="<%= blog.coverImgUrl || '/img/default-cover.png' %>"
                                        class="card-img-top"
                                        style="height: 180px; object-fit: cover;"
                                        alt="<%= blog.title %>"
                                    >

                                    <div class="card-body d-flex flex-column">
                                        <h5 class="card-title"><%= blog.title %></h5>

                                        <p class="card-text text-muted">
                                            <%= blog.body.length > 100 ? blog.body.substring(0, 100) + '...' : blog.body %>
                                        </p>

                                        <div class="mt-auto d-flex justify-content-between align-items-end gap-2">
                                            <div class="d-flex gap-2">
                                                <a href="/blog/<%= blog._id %>" class="btn btn-primary">Read More</a>

                                                <% if (locals.user && blog.createdBy.toString()===locals.user._id.toString()) { %>
                                                    <form
                                                        action="/blog/<%= blog._id %>/delete"
                                                        method="POST"
                                                        onsubmit="return confirm('Are you sure you want to delete this?')"
                                                    >
                                                        <button type="submit" class="btn btn-outline-danger">Delete</button>
                                                    </form>
                                                <% } %>
                                            </div>

                                            <div class="text-end">
                                                <%# Normalize likes before checking active state or showing count. %>
                                                <% const likes = Array.isArray(blog.likes) ? blog.likes : []; %>
                                                <% const alreadyLiked = locals.user && likes.some(userId => userId.toString() === locals.user._id.toString()); %>
                                                <% if (locals.user && blog.createdBy.toString() !== locals.user._id.toString()) { %>
                                                    <form action="/blog/like/<%= blog._id %>" method="POST">
                                                        <button type="submit" class="btn <%= alreadyLiked ? 'btn-danger' : 'btn-outline-danger' %> btn-sm">
                                                            <i class="bi bi-heart"></i> <%= likes.length %>
                                                        </button>
                                                    </form>
                                                <% } else { %>
                                                    <span class="btn btn-outline-secondary btn-sm disabled">
                                                        <i class="bi bi-heart"></i> <%= likes.length %>
                                                    </span>
                                                <% } %>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                <% } %>
            </main>

            <%# Bootstrap JavaScript is loaded after the content. %>
                <%- include('./partials/scripts') %>
        </body>

        </html>
